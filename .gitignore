# Secrets, never commit these (copy fleet/.env.example to fleet/.env instead)
.env
.env.*
!.env.example
cred.json

# Local databases and logs
*.db
*.log

# Sale data read from the POS and saved receipts
hex/
pdfs/
*.pdf

# Python environments and PyInstaller output
.venv/
.venv-linux/
.venv*/
__pycache__/
*.pyc
build/
dist/

# Local-only extras
ui_backup_original/
*.lnk

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Fetched per machine: the WebView2 SDK (setup_venv.bat) and the chromedriver of the
# installed runtime's major (downloaded on first start), plus a download cut short
fleet/webview2/
fleet/drivers/chromedriver_*.exe
fleet/drivers/*.part

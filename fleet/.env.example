# Copy this file to .env (in the same folder) and fill in the real values.
# When running a PyInstaller build, put .env next to the .exe instead.
MONGODB_URI="mongodb://USERNAME:PASSWORD@HOST:27017/fuelzone?authSource=admin&replicaSet=rs0"

# FleetCard website login used by fleet.py
FLEETCARD_USER="your-fleetcard-username"
FLEETCARD_PASS="your-fleetcard-password"
